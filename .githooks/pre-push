#!/bin/sh
# Runs the checks that GitHub no longer runs on the deploy path.
#
# The real-browser suite needs Chrome and roughly two and a half minutes, which made the
# Pages deployment take upwards of forty minutes. It runs here instead, before the push,
# so that main only ever receives a revision that already passed it.
#
# Skip a single push with: git push --no-verify
# Skip every push in a session with: FANTASY_CRUX_SKIP_CHECKS=1 git push

if [ "${FANTASY_CRUX_SKIP_CHECKS:-}" = "1" ]; then
  echo "pre-push: FANTASY_CRUX_SKIP_CHECKS=1 — skipping the checks."
  exit 0
fi

# Nothing to verify when the push only deletes remote refs.
pushing_a_commit=0
while read -r _local_ref local_oid _remote_ref _remote_oid; do
  case "$local_oid" in
    '' | 0000000000000000000000000000000000000000) ;;
    *) pushing_a_commit=1 ;;
  esac
done

if [ "$pushing_a_commit" -eq 0 ]; then
  exit 0
fi

# check:deploy rather than check: ADR/commit bc1561c keeps the archived legacy docs under
# art/archive/ out of the gate, and prettier still reports them.
echo "pre-push: running npm run check:deploy (content, unit, build, HTML, links, browser)..."

if ! npm run --silent check:deploy; then
  echo ''
  echo 'pre-push: checks failed — push aborted.'
  echo 'Fix the failures, or push anyway with: git push --no-verify'
  exit 1
fi

echo 'pre-push: checks passed.'
