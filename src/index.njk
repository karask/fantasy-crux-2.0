---
layout: layouts/base.njk
permalink: /index.html
bodyClass: home-page
---
<div class="home-surface">
  <section class="home-hero" aria-labelledby="home-title">
    <picture class="home-hero-picture">
      <img
        class="home-hero-art"
        src="/assets/images/home/index-tower-hero.webp"
        srcset="/assets/images/home/index-tower-hero-960.webp 960w, /assets/images/home/index-tower-hero.webp 1672w"
        sizes="(max-width: 720px) 100vw, calc(100vw - 220px)"
        width="1672"
        height="941"
        alt="Four adventurers cross a rain-soaked marsh toward a lonely candlelit tower at sunset while a creature lurks behind a dead tree."
        loading="eager"
        decoding="async"
        fetchpriority="high"
      >
    </picture>
    <header class="home-hero-caption">
      <p class="eyebrow">Fantasy Crux 2.0 · Complete playtest rules</p>
      <h1 id="home-title">Roll under. Read the situation. Live with the consequence.</h1>
    </header>
  </section>

  <section class="chapter-directory" aria-labelledby="directory-title">
    <div class="section-rule section-rule--dark">
      <div>
        <p class="eyebrow">Contents</p>
        <h2 id="directory-title">The rules</h2>
      </div>
      <p>{{ collections.chapters | length }} chapters</p>
    </div>
    <ol>
      {% for chapter in collections.chapters %}
        <li>
          <a href="{{ chapter.url }}">
            <span class="directory-number">{{ chapter.data.order | padChapter }}</span>
            <span class="directory-copy">
              <strong>{{ chapter.data.title }}</strong>
              <small>{{ chapter.data.summary | summaryText }}</small>
            </span>
            <span class="directory-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      {% endfor %}
    </ol>
  </section>
</div>
