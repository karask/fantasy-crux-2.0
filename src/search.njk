---
layout: layouts/base.njk
title: Search
summary: Search every rule, Talent, and creature in Fantasy Crux 2.0 Beta.
order: 9
permalink: /search/index.html
---
<div class="page-surface search-page" data-search-page>
  <header class="chapter-heading">
    <p class="eyebrow">Rules finder</p>
    <h1>Search</h1>
    <p class="chapter-deck">Searches every rule, Talent, Shaping section, and creature profile. Results link straight to the section inside its chapter.</p>
  </header>

  <form class="search-form" role="search" data-search-form>
    <label for="rules-search">Rule, term, or Talent</label>
    <div>
      <input id="rules-search" name="q" type="search" autocomplete="off" placeholder="Try ‘shield’, ‘major wound’, or ‘Shaping’" data-search-input>
      <button class="button button--primary" type="submit">Search</button>
    </div>
  </form>
  <p class="search-status" role="status" aria-live="polite" data-search-status>Enter a term to search the rules.</p>
  <ol class="search-results" data-search-results></ol>
  <script type="application/json" data-section-titles>{{ collections.sectionTitles | json | safe }}</script>
  <noscript><p class="notice">Search needs JavaScript. All rules remain available through the chapter menu.</p></noscript>
</div>
