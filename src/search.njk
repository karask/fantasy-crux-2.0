<div class="page-surface search-page" data-search-page>
  <header class="chapter-heading">
    <p class="eyebrow">Rules finder</p>
    <h1>Search</h1>
    <p class="chapter-deck">Searches individual rules and Talents. Chapter hubs and the unfinished Magic section are excluded.</p>
  </header>

  <form class="search-form" role="search" data-search-form>
    <label for="rules-search">Rule, term, or Talent</label>
    <div>
      <input id="rules-search" name="q" type="search" autocomplete="off" placeholder="Try ‘shield’, ‘major wound’, or ‘falling’" data-search-input>
      <button class="button button--primary" type="submit">Search</button>
    </div>
  </form>
  <p class="search-status" role="status" aria-live="polite" data-search-status>Enter a term to search the rules.</p>
  <ol class="search-results" data-search-results></ol>
  <noscript><p class="notice">Search needs JavaScript. All rules remain available through the chapter menu and <a href="/reference/">Quick Reference</a>.</p></noscript>
</div>
