---
layout: layouts/base.njk
---
<div class="page-surface rule-page talent-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/rules/talents/">Talents</a>
    <span aria-hidden="true">/</span>
    <span>{{ title }}</span>
  </nav>

  <header class="rule-heading talent-heading">
    <div class="talent-cost talent-cost--large"><strong>{{ cost }}</strong><span>IP</span></div>
    <div>
      <p class="eyebrow">{{ activation }} talent</p>
      <h1 data-pagefind-meta="title">{{ title }}</h1>
      <p class="rule-deck">{{ summary | summaryText }}</p>
    </div>
  </header>

  <dl class="talent-facts">
    <div><dt>Cost</dt><dd>{{ cost }} Improvement Points</dd></div>
    <div><dt>Requires</dt><dd>{{ prerequisites | summaryText }}</dd></div>
    <div><dt>Use</dt><dd>{{ activation }}</dd></div>
  </dl>

  <div class="reading-grid">
    <article class="prose rule-copy" data-pagefind-body data-pagefind-meta="chapter:talents">
      <span class="search-index-context" aria-hidden="true" data-pagefind-meta="title">{{ title }}</span>
      <p class="search-index-context" aria-hidden="true" data-pagefind-weight="0.5">
        {{ title }}. {{ summary | summaryText }} Also known as {{ aliases | join(', ') }}. Costs {{ cost }} Improvement Points. Requires {{ prerequisites | summaryText }}. {{ activation }} Talent. Tags: {{ tags | join(', ') }}.
      </p>
      {{ content | safe }}
    </article>
    <aside class="at-table" aria-labelledby="at-table-title">
      <p class="eyebrow">Purchase note</p>
      <h2 id="at-table-title">At the table</h2>
      <p>{{ summary | summaryText }}</p>
      <p class="aliases"><span>Tags:</span> {{ tags | join(', ') }}</p>
      <a href="/rules/talents/">All Talents <span aria-hidden="true">→</span></a>
    </aside>
  </div>
</div>
