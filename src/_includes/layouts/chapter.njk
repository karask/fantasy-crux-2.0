---
layout: layouts/base.njk
---
{% set isTalents = id == 'talents' %}
{% set isCreatures = id == 'creatures' %}
{% set chapterArtItems = site.chapterArt[id] or [] %}
{% set chapterItems = collections.talents if isTalents else collections.rules | chapterRules(id) %}
{# Talents live in one filterable section, so the chapter has nothing to tab between. #}
{% set sectionTabCount = 1 if isTalents else chapterItems | length + (1 if isCreatures else 0) %}
<div class="page-surface chapter-page">
  {% for legacySlug in legacySlugs or [] %}
    <span id="{{ legacySlug }}" class="legacy-anchor" aria-hidden="true" data-pagefind-ignore></span>
  {% endfor %}
  <header class="chapter-heading">
    <p class="eyebrow">Chapter {{ order | padChapter }}</p>
    <h1>{{ title }}</h1>
    <p class="chapter-deck">{{ summary | summaryText }}</p>
  </header>

  {% if sectionTabCount > 1 %}
    <nav class="chapter-tabs" aria-label="In this chapter" data-pagefind-ignore>
      <span class="chapter-tabs__label">Sections</span>
      <div class="chapter-tabs__scroller">
        <ul>
          {% if isTalents %}
            <li><a href="#talent-list-title">All Talents</a></li>
          {% endif %}
          {% for item in chapterItems %}
            <li><a href="#{{ item.data.slug }}">{{ item.data.title }}</a></li>
          {% endfor %}
          {% if isCreatures %}
            <li><a href="#creature-list-title">Creature Profiles</a></li>
          {% endif %}
        </ul>
      </div>
    </nav>
  {% endif %}

  <article class="prose chapter-intro"{% if id == 'gazetteer' %} data-pagefind-body data-pagefind-meta="chapter:gazetteer,title:Gazetteer"{% else %} data-pagefind-ignore{% endif %}>
    {% set chapterIntro = content %}
    {% if id == 'gazetteer' %}
      {% set gazetteerMap %}{% include "partials/gazetteer-map.njk" %}{% endset %}
      {% set chapterIntro = chapterIntro | placeAfterHeading('the-shape-of-the-realms', gazetteerMap) %}
    {% endif %}
    {{ chapterIntro | safe }}
  </article>

  {% if isTalents %}
    <section class="talent-browser" aria-labelledby="talent-list-title" data-filter-browser>
      <div class="section-rule" data-pagefind-ignore>
        <div>
          <p class="eyebrow">Purchase catalogue</p>
          <h2 id="talent-list-title">All Talents</h2>
        </div>
        <p role="status" aria-live="polite"><span data-filter-count>{{ chapterItems | length }}</span> Talents available</p>
      </div>
      <div class="filter-bar" role="group" aria-label="Filter Talents" data-pagefind-ignore>
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        <button type="button" data-filter="offence" aria-pressed="false">Offence</button>
        <button type="button" data-filter="defence" aria-pressed="false">Defence</button>
        <button type="button" data-filter="ranged" aria-pressed="false">Ranged</button>
        <button type="button" data-filter="shield" aria-pressed="false">Shield</button>
        <button type="button" data-filter="unarmed" aria-pressed="false">Unarmed</button>
        <button type="button" data-filter="magic" aria-pressed="false">Magic</button>
        <button type="button" data-filter="stealth" aria-pressed="false">Stealth</button>
        <button type="button" data-filter="social" aria-pressed="false">Social</button>
        <button type="button" data-filter="craft" aria-pressed="false">Craft</button>
        <button type="button" data-filter="survival" aria-pressed="false">Survival</button>
        <button type="button" data-filter="healing" aria-pressed="false">Healing</button>
        <button type="button" data-filter="general" aria-pressed="false">General</button>
      </div>
      <div class="talent-list">
        {% for item in chapterItems %}
          {% set talent = item.data %}
          {# "General" is a filter bucket, not a tag: it gathers the Talents that serve every role rather than one style of play. #}
          {% set isGeneral = 'training' in talent.tags or 'awareness' in talent.tags or 'mobility' in talent.tags %}
          <article class="talent-profile" data-filter-item data-filter-tags="{{ talent.tags | join(' ') }}{{ ' general' if isGeneral }}" data-pagefind-body data-pagefind-meta="chapter:talents">
            {% for legacySlug in talent.legacySlugs or [] %}
              <span id="{{ legacySlug }}" class="legacy-anchor" aria-hidden="true" data-pagefind-ignore></span>
            {% endfor %}
            <header class="rule-section-heading talent-profile-heading">
              <div class="talent-cost talent-cost--large"><strong>{{ talent.cost }}</strong><span>IP</span></div>
              <div>
                <p class="eyebrow">{{ talent.activation }} talent</p>
                <h2 id="{{ talent.slug }}" data-pagefind-meta="title">
                  {{ talent.title }}
                  <a class="heading-anchor" href="#{{ talent.slug }}" aria-label="Link to this section" data-pagefind-ignore></a>
                </h2>
                <p class="rule-deck">{{ talent.summary | summaryText }}</p>
              </div>
            </header>

            <dl class="talent-facts">
              <div><dt>Cost</dt><dd>{{ talent.cost }} Improvement Points</dd></div>
              <div><dt>Requires</dt><dd>{{ talent.prerequisites | summaryText }}</dd></div>
              <div><dt>Use</dt><dd>{{ talent.activation }}</dd></div>
            </dl>

            <div class="prose rule-copy">
              <p class="search-index-context" aria-hidden="true" data-pagefind-weight="0.5">
                {{ talent.title }}. {{ talent.summary | summaryText }}{% if talent.aliases %} Also known as {{ talent.aliases | join(', ') }}.{% endif %} Costs {{ talent.cost }} Improvement Points. Requires {{ talent.prerequisites | summaryText }}. {{ talent.activation }} Talent. Tags: {{ talent.tags | join(', ') }}.
              </p>
              {% set renderedTalent = item.templateContent | inlineSection(talent.slug) %}
              {% for chapterArt in chapterArtItems %}
                {% if chapterArt.rule == talent.slug %}
                  {% set chapterArtMarkup %}{% include "partials/chapter-art.njk" %}{% endset %}
                  {% if chapterArt.position == 'rule-start' %}
                    {% set renderedTalent = chapterArtMarkup ~ renderedTalent %}
                  {% else %}
                    {% set renderedTalent = renderedTalent | placeAfterHeading(talent.slug ~ '--' ~ chapterArt.afterHeading, chapterArtMarkup) %}
                  {% endif %}
                {% endif %}
              {% endfor %}
              {{ renderedTalent | safe }}
            </div>
          </article>
        {% endfor %}
      </div>
      <p class="filter-empty" data-filter-empty hidden>No Talents match this filter.</p>
    </section>
  {% endif %}

  {# Talents already rendered above, inside their filterable section. #}
  <div class="chapter-sections">
    {% for item in chapterItems if not isTalents %}
      {% set rule = item.data %}
      <section class="rule-section" data-pagefind-body data-pagefind-meta="chapter:{{ id }}">
        {% for legacySlug in rule.legacySlugs or [] %}
          <span id="{{ legacySlug }}" class="legacy-anchor" aria-hidden="true" data-pagefind-ignore></span>
        {% endfor %}
        <header class="rule-section-heading">
          <div>
            <h2 id="{{ rule.slug }}" data-pagefind-meta="title">
              {{ rule.title }}
              <a class="heading-anchor" href="#{{ rule.slug }}" aria-label="Link to this section" data-pagefind-ignore></a>
            </h2>
            {% if rule.summary is iterable and rule.summary is not string %}
              <ul class="rule-deck">
                {% for line in rule.summary %}<li>{{ line }}</li>{% endfor %}
              </ul>
            {% else %}
              <p class="rule-deck">{{ rule.summary }}</p>
            {% endif %}
          </div>
        </header>

        <div class="prose rule-copy">
          <p class="search-index-context" aria-hidden="true" data-pagefind-weight="0.5">
            {{ rule.title }}. {{ rule.summary | summaryText }}{% if rule.aliases %} Also known as {{ rule.aliases | join(', ') }}.{% endif %}
          </p>
          {% set inlineRule = item.templateContent | inlineSection(rule.slug) %}
          {% set renderedRule = inlineRule %}
          {% for chapterArt in chapterArtItems %}
            {% if chapterArt.rule == rule.slug %}
              {% set chapterArtMarkup %}{% include "partials/chapter-art.njk" %}{% endset %}
              {% if chapterArt.position == 'rule-start' %}
                {% set renderedRule = chapterArtMarkup ~ renderedRule %}
              {% else %}
                {% set renderedRule = renderedRule | placeAfterHeading(rule.slug ~ '--' ~ chapterArt.afterHeading, chapterArtMarkup) %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {{ renderedRule | safe }}
        </div>
      </section>
    {% endfor %}
  </div>

  {% if isCreatures %}
    <section class="creature-browser" aria-labelledby="creature-list-title" data-filter-browser>
      <div class="section-rule" data-pagefind-ignore>
        <div>
          <p class="eyebrow">Bestiary</p>
          <h2 id="creature-list-title">Creature Profiles</h2>
        </div>
        <p role="status" aria-live="polite"><span data-filter-count>{{ collections.creatures | length }}</span> creatures shown</p>
      </div>
      <div class="filter-bar" role="group" aria-label="Filter creatures by type" data-pagefind-ignore>
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        <button type="button" data-filter="animal" aria-pressed="false">Animals</button>
        <button type="button" data-filter="monster" aria-pressed="false">Monsters</button>
        <button type="button" data-filter="nymph" aria-pressed="false">Nymphs</button>
        <button type="button" data-filter="spirit" aria-pressed="false">Spirits</button>
        <button type="button" data-filter="undead" aria-pressed="false">Undead</button>
      </div>
      <div class="creature-grid">
        {% for creature in collections.creatures %}
          {% include "partials/creature-profile.njk" %}
        {% endfor %}
      </div>
      <p class="filter-empty" data-filter-empty hidden>No creatures match this filter.</p>
    </section>
  {% endif %}
</div>
