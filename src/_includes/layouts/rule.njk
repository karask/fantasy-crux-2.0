---
layout: layouts/base.njk
---
<div class="page-surface rule-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/rules/{{ chapter }}/">{{ chapter | replace('-', ' ') | title }}</a>
    <span aria-hidden="true">/</span>
    <span>{{ title }}</span>
  </nav>

  <header class="rule-heading">
    <p class="eyebrow">{{ chapter | replace('-', ' ') }} · rule {{ order }}</p>
    <h1 data-pagefind-meta="title">{{ title }}</h1>
    {% if summary is iterable and summary is not string %}
      <ul class="rule-deck">
        {% for line in summary %}<li>{{ line }}</li>{% endfor %}
      </ul>
    {% else %}
      <p class="rule-deck">{{ summary }}</p>
    {% endif %}
  </header>

  <div class="reading-grid">
    <article class="prose rule-copy" data-pagefind-body data-pagefind-meta="chapter:{{ chapter }}">
      <span class="search-index-context" aria-hidden="true" data-pagefind-meta="title">{{ title }}</span>
      <p class="search-index-context" aria-hidden="true" data-pagefind-weight="0.5">
        {{ title }}. {{ summary | summaryText }}{% if aliases %} Also known as {{ aliases | join(', ') }}.{% endif %}
      </p>
      {{ content | safe }}
    </article>

    <aside class="at-table" aria-labelledby="at-table-title">
      <p class="eyebrow">Fast ruling</p>
      <h2 id="at-table-title">At the table</h2>
      <p>{{ summary | summaryText }}</p>
      {% if aliases %}<p class="aliases"><span>Also:</span> {{ aliases | join(', ') }}</p>{% endif %}
      <a href="/reference/">Open quick reference <span aria-hidden="true">→</span></a>
    </aside>
  </div>
</div>
